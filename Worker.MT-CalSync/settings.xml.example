<?xml version="1.0" encoding="utf-8"?>
<!--
    MT-CalSync settings.xml template, for a development checkout.

    A server doesn't need this file: deploy/provision.sh writes /etc/mtcalsync/settings.xml
    with the database connection and a freshly generated DataEncryptionKey.

    For local development, copy it to SelfHost.MT-CalSync/settings.xml (and to
    Worker.MT-CalSync/settings.xml to run the CLI). Both are gitignored, and the build
    copies them next to the binaries. Fill in the two required values below.

    Everything else (the sign-in OAuth clients, app-only credentials, SMTP, sync defaults)
    is entered on the portal's Settings page, which keeps it in the database with the
    secrets encrypted. A value in this file is only a fallback for one the database
    doesn't have, so leave the rest out unless you have a reason.
-->
<settings>
    <!-- Required. MySQL 8 (MariaDB is not supported). -->
    <MySqlDatabaseConnection>Server=127.0.0.1;Port=3306;Database=mtcalsync_dev;Uid=mtcalsync;Pwd=CHANGE_ME;SslMode=Required;</MySqlDatabaseConnection>

    <!-- Required. Base64 of 32 random bytes: openssl rand -base64 32
         It encrypts every stored secret, so back it up with the database. Losing it means
         entering every secret again and reconnecting every account. -->
    <DataEncryptionKey></DataEncryptionKey>

    <!-- Optional, read from this file only. Where the key ring for sign-in cookies and
         OAuth state is kept: /etc/mtcalsync/dpkeys on a server, otherwise a dpkeys
         folder next to the binaries. -->
    <!-- <DataProtectionKeysPath>/path/to/dpkeys</DataProtectionKeysPath> -->

    <!-- Optional, read from this file only. The namespace of the provenance stamp on every
         mirrored event. Never change it on an install that has synced: existing stamps
         would no longer be recognised, so mirrors would look like your own events. -->
    <!-- <ExtPropNamespaceGuid>b7c9e3a2-6d41-4f8b-9c2e-a1b2c3d4e5f6</ExtPropNamespaceGuid> -->
</settings>
