@model HomeViewModel
@{
    ViewData["Title"] = "System";
    string Badge(bool ok) => ok ? "ok" : "warn";
    string Optional(bool ok) => ok ? "ok" : "off";
    // A passing test that read no calendar has only checked the database and settings.
    bool testedLive = Model.TestCalendars > 0;
    string resultBadge = Model.TestOk == true && testedLive ? "ok" : "warn";
    string resultText = Model.TestOk != true ? "FAIL" : (testedLive ? "PASS" : "Settings only");
}

<h1>System</h1>
<p class="muted" style="margin-bottom:16px">Configuration status and sync-pair health.</p>

<div class="card">
    <h2>Configuration</h2>
    <div class="row">
        <div>Database <span class="badge @(Model.DbOk?"ok":"warn")">@(Model.DbOk ? "connected" : "error")</span>
            @if (!Model.DbOk) { <div class="muted">@Model.DbMessage</div> }
        </div>
        <div>Google sign-in <span class="badge @Badge(Model.GoogleOAuthConfigured)">@(Model.GoogleOAuthConfigured ? "configured" : "not set")</span></div>
        <div>Microsoft sign-in <span class="badge @Badge(Model.MsOAuthConfigured)">@(Model.MsOAuthConfigured ? "configured" : "not set")</span></div>
        <div>Email alerts <span class="badge @(Model.SmtpConfigured?"ok":"off")">@(Model.SmtpConfigured ? "configured" : "off")</span></div>
    </div>
    <div class="row" style="margin-top:10px">
        <div>Google service account <span class="badge @Optional(Model.GoogleConfigured)">@(Model.GoogleConfigured ? "configured" : "not set")</span></div>
        <div>Microsoft app-only <span class="badge @Optional(Model.GraphConfigured)">@(Model.GraphConfigured ? "configured" : "not set")</span></div>
    </div>
    <p class="muted" style="margin:10px 0 0">
        The sign-in clients let you connect accounts on the Calendars page. The service account and
        app-only registration are needed only for app-credential pairs.
    </p>
    <div style="margin-top:16px">
        <a class="btn" asp-controller="Settings" asp-action="Index">Edit credentials &amp; settings</a>
        <form asp-action="Test" method="post" style="display:inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary">Test credentials (live)</button>
        </form>
        <span class="muted">Checks the database and your settings, then reads a few days of events from each calendar in a sync pair.</span>
    </div>
</div>

@if (Model.TestReport != null)
{
    <div class="card">
        <h2>Test result <span class="badge @resultBadge">@resultText</span></h2>
        @if (Model.TestOk == true && !testedLive)
        {
            <p class="muted">No calendar was contacted, because there's no sync pair yet. Create one on the
                <a asp-controller="Pairs" asp-action="Index">Pairs</a> page, then run the test again to check live access.</p>
        }
        <pre class="report">@string.Join("\n", Model.TestReport)</pre>
    </div>
}

<div class="card">
    <h2>Sync pairs</h2>
    @if (Model.Pairs.Count == 0)
    {
        <p class="muted">No pairs yet. <a asp-controller="Pairs" asp-action="Index">Create one</a> to start syncing.</p>
    }
    else
    {
        <table>
            <thead><tr><th>#</th><th>Name</th><th>M365</th><th>Google</th><th>Mode</th><th>Tokens</th><th>Last success</th><th>Maps</th><th>Dead</th><th></th></tr></thead>
            <tbody>
            @foreach (var p in Model.Pairs)
            {
                <tr>
                    <td>@p.PairID</td>
                    <td>@p.Name @(p.Enabled ? "" : Html.Raw("<span class='badge off'>paused</span>"))</td>
                    <td class="muted">@p.M365Email</td>
                    <td class="muted">@p.GoogleEmail</td>
                    <td class="muted">@p.Direction<br />@p.Fidelity / @p.Recurrence</td>
                    <td>@(p.M365Token ? "M365✓" : "M365–") @(p.GoogleToken ? "G✓" : "G–")</td>
                    <td class="muted">@p.LastSuccess</td>
                    <td>@p.Mappings</td>
                    <td>@(p.OpenDeadLetters > 0 ? Html.Raw($"<span class='badge warn'>{p.OpenDeadLetters}</span>") : Html.Raw("0"))</td>
                    <td>
                        <form asp-controller="Pairs" asp-action="SetEnabled" method="post" style="margin:0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@p.PairID" />
                            <input type="hidden" name="enabled" value="@((!p.Enabled).ToString().ToLower())" />
                            <button class="btn btn-sm" type="submit">@(p.Enabled ? "Pause" : "Resume")</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
    <div style="margin-top:12px"><a class="btn" asp-controller="Pairs" asp-action="Index">Manage pairs</a></div>
</div>
