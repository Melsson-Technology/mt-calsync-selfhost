<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    <title>@ViewData["Title"] · MT-CalSync</title>
    <style>
        * { box-sizing: border-box; }
        body { margin:0; min-height:100vh; display:flex; align-items:flex-start; justify-content:center;
               background:
                   radial-gradient(700px 380px at 15% -5%, rgba(99,102,241,.14), transparent 60%),
                   radial-gradient(600px 340px at 90% 0%, rgba(34,211,238,.10), transparent 55%),
                   #f6f7fb;
               font-family:-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif; color:#334155;
               -webkit-font-smoothing:antialiased; }
        .login { width:360px; margin-top:11vh; padding:0 12px; }
        .brandline { display:flex; align-items:center; justify-content:center; gap:9px;
                     font-weight:700; font-size:16px; color:#0f172a; margin-bottom:18px; letter-spacing:.2px; }
        .brandline::before { content:""; width:20px; height:20px; border-radius:6px;
                             background:linear-gradient(135deg,#6366f1 0%,#8b5cf6 55%,#22d3ee 130%);
                             box-shadow:0 0 0 3px rgba(99,102,241,.18); }
        .card { background:#fff; border:1px solid #e2e8f0; border-radius:14px; padding:28px 26px;
                box-shadow:0 10px 30px rgba(15,23,42,.08); }
        h1 { font-size:19px; margin:0 0 3px; color:#0f172a; letter-spacing:-.2px; }
        .muted { color:#64748b; font-size:13px; margin:0 0 18px; line-height:1.5; }
        label { display:block; font-size:12px; color:#64748b; margin-bottom:5px; font-weight:600; }
        input { width:100%; padding:9px 11px; border:1px solid #e2e8f0; border-radius:8px; font:inherit;
                color:#0f172a; margin-bottom:14px; transition:border-color .12s, box-shadow .12s; }
        input:focus { outline:none; border-color:#4f46e5; box-shadow:0 0 0 3px rgba(79,70,229,.14); }
        button { width:100%; padding:10px; border:0; border-radius:8px; background:#4f46e5; color:#fff;
                 font:inherit; font-weight:650; cursor:pointer; box-shadow:0 1px 2px rgba(79,70,229,.35);
                 transition:background .12s; }
        button:hover { background:#4338ca; }
        .alert { background:#fef2f2; color:#b91c1c; border:1px solid #fecaca; padding:9px 12px;
                 border-radius:8px; font-size:13px; margin-bottom:14px; font-weight:500; }
        .notice { background:#ecfdf5; color:#047857; border:1px solid #a7f3d0; padding:9px 12px;
                  border-radius:8px; font-size:13px; margin-bottom:14px; font-weight:500; }
        .links { font-size:13px; color:#64748b; text-align:center; margin:18px 0 0; }
        .links a { color:#4f46e5; text-decoration:none; font-weight:600; }
        .links a:hover { text-decoration:underline; }
        .links span { margin:0 6px; color:#cbd5e1; }
    </style>
</head>
<body>
    <div class="login">
        <div class="brandline">MT-CalSync</div>
        @RenderBody()
    </div>
</body>
</html>
