@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<div class="card">
    <h1>Something went wrong</h1>
    <p class="muted">An unexpected error occurred processing your request.</p>
    @if (Model.ShowRequestId)
    {
        <p class="muted">Request ID: <code>@Model.RequestId</code></p>
    }
    <a class="btn" asp-controller="Home" asp-action="Index">Back to dashboard</a>
</div>
