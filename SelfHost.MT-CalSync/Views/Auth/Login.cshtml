@{
    ViewData["Title"] = "Sign in";
    Layout = "_LayoutMinimal";
}
<div class="card">
    <h1>Sign in</h1>
    <p class="muted">Enter the operator password for this MT-CalSync instance.</p>
    @if (ViewBag.Error != null) { <div class="alert">@ViewBag.Error</div> }
    <form method="post" asp-controller="Auth" asp-action="Login">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@(ViewBag.ReturnUrl as string)" />
        <label for="password">Password</label>
        <input type="password" id="password" name="password" autofocus autocomplete="current-password" />
        <button type="submit">Sign in</button>
    </form>
</div>
