@using Core.MTCalSync
@{
    ViewData["Title"] = "Connected accounts";
    var accounts = (List<OAuthAccount>)ViewBag.Accounts;
    bool msConfigured = (bool)ViewBag.MsConfigured;
    bool googleConfigured = (bool)ViewBag.GoogleConfigured;
}

<h1>Connected accounts</h1>
<p class="muted">Connect the Google and Microsoft accounts whose calendars you want to keep in sync.</p>

<div class="card">
    <h2>Add a connection</h2>
    <p>
        <a class="btn btn-primary" asp-action="Start" asp-route-provider="google">Connect Google</a>
        <a class="btn btn-primary" asp-action="Start" asp-route-provider="microsoft">Connect Microsoft</a>
    </p>
    @if (!googleConfigured || !msConfigured)
    {
        @* A self-hoster registers their own OAuth apps, so "not available yet" left them
           with nothing to do. Say what's missing and where it goes. *@
        string missing = !googleConfigured && !msConfigured ? "Google and Microsoft" : (!googleConfigured ? "Google" : "Microsoft");
        <p class="muted">
            To connect @missing accounts, add your @missing OAuth client@(!googleConfigured && !msConfigured ? "s" : "")
            under <a asp-controller="Settings" asp-action="Index">Settings</a>. <code>_docs/PROVIDER-SETUP.md</code>
            explains how to create @(!googleConfigured && !msConfigured ? "them" : "one").
        </p>
    }
    <p class="muted">You sign in on Google's or Microsoft's own page, so this server never sees your password.
        It keeps the access tokens encrypted, and disconnecting an account deletes them.</p>
    @if ((bool)(ViewBag.UnverifiedAppNotice ?? false))
    {
        <p class="muted">Heads-up: Google shows an "unverified app" screen for OAuth apps it hasn't reviewed, which is
            normal for a self-hosted install, and Microsoft may show your app as unverified too. If this is your
            own server, choose "Advanced" and continue. The app asks only for calendar access and your basic
            sign-in details.</p>
    }
</div>

<div class="card">
    <h2>Your accounts</h2>
    @if (accounts.Count == 0)
    {
        <p class="muted">Nothing connected yet.</p>
    }
    else
    {
        <table>
            <tr><th>Provider</th><th>Account</th><th>Status</th><th></th><th></th></tr>
            @foreach (var a in accounts)
            {
                <tr>
                    <td>@(a.provider == "google" ? "Google" : "Microsoft")</td>
                    <td>@a.principalEmail</td>
                    <td>
                        @if (a.isConnected)
                        {
                            <span class="badge ok">connected</span>
                        }
                        else
                        {
                            <span class="badge warn">needs reconnect</span>
                            <a class="btn btn-sm" asp-action="Start" asp-route-provider="@(a.provider == "google" ? "google" : "microsoft")">Reconnect</a>
                        }
                    </td>
                    <td><a class="btn btn-sm" asp-action="Calendars" asp-route-accountId="@a.oauthAccountID">Calendars</a></td>
                    <td>
                        <form asp-action="Disconnect" method="post" onsubmit="return confirm('Disconnect @a.principalEmail? Stored tokens are deleted; sync pairs using it must be removed first.');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="accountId" value="@a.oauthAccountID" />
                            <button class="btn btn-sm" type="submit">Disconnect</button>
                        </form>
                    </td>
                </tr>
            }
        </table>
    }
</div>
