@model SharedCalendarsViewModel
@{
    ViewData["Title"] = "Shared calendars";
}

<h1>Shared calendars</h1>
<p class="muted" style="margin-bottom:16px">
    Google calendars visible to <strong>@Model.GoogleEmail</strong>. Check one to mirror its events into your
    Microsoft&nbsp;365 primary calendar (<strong>@Model.M365Email</strong>). One-way: Google&nbsp;→&nbsp;M365.
</p>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="card"><p class="muted">@Model.Error</p></div>
}
else
{
    <div class="card">
        <h2>Available calendars</h2>
        @if (Model.Calendars.Count == 0)
        {
            <p class="muted">No shared calendars found for @Model.GoogleEmail.</p>
        }
        else
        {
            <table>
                <thead><tr><th style="width:36px"></th><th>Calendar</th><th>Access</th><th>Status</th><th>Events</th></tr></thead>
                <tbody>
                @foreach (var c in Model.Calendars)
                {
                    <tr>
                        <td>
                            <form asp-action="Toggle" method="post" style="margin:0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="calendarId" value="@c.CalendarId" />
                                <input type="hidden" name="summary" value="@c.Summary" />
                                <input type="hidden" name="enable" value="@((!c.IsSynced).ToString().ToLower())" />
                                <input type="checkbox" style="width:auto" @(c.IsSynced ? "checked" : "")
                                       onchange="if(!this.checked &amp;&amp; !confirm('Remove this calendar and delete its mirrored events from your M365 primary calendar?')){this.checked=true;return;} this.form.submit();" />
                            </form>
                        </td>
                        <td>@c.Summary<br /><span class="muted" style="font-size:11px">@c.CalendarId</span></td>
                        <td class="muted">@c.AccessRole</td>
                        <td>
                            @if (c.IsSynced && c.Enabled)
                            {
                                <span class="badge ok">syncing</span>
                            }
                            else if (c.IsSynced)
                            {
                                <span class="badge warn">paused</span>
                            }
                            else
                            {
                                <span class="badge off">off</span>
                            }
                        </td>
                        <td>@(c.IsSynced ? c.Mappings.ToString() : "n/a")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
    <p class="muted">
        Checking a calendar creates a one-way Google&nbsp;→&nbsp;M365 sync; events appear on the next run (within ~5&nbsp;min).
        Unchecking deletes the events it mirrored into your M365 primary calendar and removes the sync. Re-checking rebuilds them.
    </p>
}
