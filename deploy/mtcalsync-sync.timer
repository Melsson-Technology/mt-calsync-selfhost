[Unit]
Description=MT-CalSync sync scheduler tick (every minute)

[Timer]
# First run 2 min after boot, then every minute. Each tick runs only the pairs
# whose nextRunAt has arrived (default cadence 5 min per pair, plus jitter and
# failure backoff), so a quiet tick is one cheap DB query. There is no catch-up to
# arrange after downtime: the first tick after boot runs every pair that fell due
# meanwhile. (Persistent= only applies to OnCalendar= timers, so it isn't set.)
# systemd never overlaps a still-running oneshot, and the per-pair lease lock
# guards besides.
OnBootSec=2min
OnUnitActiveSec=1min
Unit=mtcalsync-worker@sync.service

[Install]
WantedBy=timers.target
