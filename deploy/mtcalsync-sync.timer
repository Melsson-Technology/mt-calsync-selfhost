[Unit]
Description=MT-CalSync sync scheduler tick (every minute)

[Timer]
# First run 2 min after boot, then every minute. Each tick runs only pairs whose
# nextRunAt has arrived (5 min per pair by default, plus jitter and backoff), so a
# quiet tick is one DB query, and the first tick after downtime catches up. Persistent=
# applies only to OnCalendar= timers, so it isn't set. systemd never overlaps a running
# oneshot, and the per-pair lease also guards against overlap.
OnBootSec=2min
OnUnitActiveSec=1min
Unit=mtcalsync-worker@sync.service

[Install]
WantedBy=timers.target
