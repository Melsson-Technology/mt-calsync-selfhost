# systemd EnvironmentFile for the MT-CalSync self-host portal
# (installed at /etc/mtcalsync/selfhost.env).
# Runtime settings only, never app secrets. Those live in /etc/mtcalsync/settings.xml
# (DB connection + DataEncryptionKey) and the encrypted DB settings table (entered in
# the UI). The operator password is set with:  mtcs set-admin-password  (it prompts)
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5091
# Honor a reverse proxy's forwarded proto so cookies are marked secure. Harmless on a
# direct bind.
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
