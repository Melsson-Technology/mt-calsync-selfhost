# systemd EnvironmentFile for the MT-CalSync self-host portal
# (installed at /etc/mtcalsync/selfhost.env).
# Hosting knobs ONLY — never app secrets. Those live in /etc/mtcalsync/settings.xml
# (DB connection + DataEncryptionKey) and the encrypted DB settings table (entered in
# the UI). The operator password is set with:  mtcs set-admin-password --password <value>
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5091
# If TLS terminates at a reverse proxy, honor its forwarded proto so cookies are
# marked secure. Safe to leave on behind nginx/caddy; harmless on a direct bind.
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
